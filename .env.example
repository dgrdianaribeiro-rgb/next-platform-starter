# Chave usada para assinar os cookies de sessão (login). Gere uma com:
#   openssl rand -hex 32
AUTH_SECRET=

# Chaves VAPID usadas para enviar notificações push de alertas. Gere um par com:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo Web Push (formato mailto:).
VAPID_SUBJECT=mailto:seu-email@example.com

# Fontes para descoberta automática de imóveis via sitemap.xml público (ver data/import-sources.js
# e README). Vazio por padrão — nenhuma fonte é lida a menos que você configure isso.
# Exemplo:
# IMPORT_SOURCES=[{"name":"Exemplo","sitemapUrl":"https://www.exemplo.com.br/sitemap.xml","urlPattern":"/imovel/"}]
IMPORT_SOURCES=
